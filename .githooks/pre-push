#!/bin/sh
# Pre-push e2e gate (2026-06-06; scoped 2026-06-13 dx-audit QW-4; spec-scoped 2026-06-14 MT-1;
# re-scoped 2026-07-28 "push cheap / merge full"). The e2e suite (Playwright `_electron`) runs
# HERE — only when pushing to origin — instead of on every `git commit`. Why here and not
# pre-commit: `git commit` carries no push-intent signal, so "gate only when work reaches origin"
# is inherently a push concern. e2e was moved off GitHub Actions earlier (Actions billing) — this
# is the real gate.
#
# ── THE POLICY (2026-07-28) ──────────────────────────────────────────────────
#   PUSH  = cheap. WINDOWS leg only, and only the specs the diff can plausibly break.
#           The Linux Docker leg NEVER runs on a plain push.
#   MERGE = full. The FULL matrix (`pnpm test:e2e:matrix`, Windows + Linux Docker,
#           every spec) is MANDATORY once per PR at the pre-merge gate — run it with
#           `make check` before `gh pr merge` (CLAUDE.md › parallel sessions).
#
# Why: the previous rule escalated to the full matrix whenever the diff touched a
# "cross-platform-sensitive" path — and that list included `package.json`, which
# CLAUDE.md requires every PR to touch (the version bump). Result: the scoping was
# unreachable and EVERY push paid the full matrix (~30 min). Cross-OS insurance
# belongs at the merge gate, where it is paid exactly once per PR, not once per push.
#
# Escape hatches:
#   E2E_FULL_MATRIX=1 git push   → force the full matrix on this push
#   git push --no-verify         → skip the gate entirely (WIP push)
# A push straight to `refs/heads/main` still forces the full matrix (that IS a merge).
#
# Enabled by `core.hooksPath=.githooks` (set by the package.json `prepare` script).
#
# git passes the remote NAME as $1 and URL as $2; the refs being pushed arrive on
# stdin, one line per ref:  <local ref> <local sha> <remote ref> <remote sha>
set -e

remote_name="$1"
# Only gate pushes to origin — pushing to a fork/scratch remote shouldn't pay e2e.
[ "$remote_name" = "origin" ] || { echo "[pre-push] remote '$remote_name' != origin — skipping e2e."; exit 0; }

z40="0000000000000000000000000000000000000000"

# The refs being pushed arrive on stdin and can only be read ONCE — capture them so
# both the stale-base gate (below) and the e2e change-detection loop can consume them.
refs_input="$(cat)"

# ----- stale-base gate (2026-06-13) ------------------------------------------
# Independent of the coordination signal (Tier 2 self-check): compare the branch
# being pushed against the REAL origin/main. BLOCK a push to main on a stale base
# (would merge an un-rebased branch); WARN a stale feature push (legitimately lags,
# but should rebase before opening/merging the PR). Fail OPEN on a fetch error so a
# network blip never wedges a push. Bypass with: git push --no-verify
if command -v timeout >/dev/null 2>&1; then
  GIT_TERMINAL_PROMPT=0 timeout 20 git fetch --quiet origin main 2>/dev/null \
    || echo "[pre-push] NOTE: could not fetch origin/main — stale-base check is advisory this run."
else
  GIT_TERMINAL_PROMPT=0 git fetch --quiet origin main 2>/dev/null \
    || echo "[pre-push] NOTE: could not fetch origin/main — stale-base check is advisory this run."
fi
block_stale=0
if git rev-parse --verify --quiet origin/main >/dev/null 2>&1; then
  # Heredoc (not a pipe) so block_stale persists in THIS shell.
  while read -r sl_ref sl_sha sr_ref sr_sha; do
    [ -z "$sl_sha" ] && continue
    [ "$sl_sha" = "$z40" ] && continue                  # branch delete — nothing to rebase
    git merge-base --is-ancestor origin/main "$sl_sha" >/dev/null 2>&1 && continue  # contains origin/main → fresh
    behind="$(git rev-list --count "${sl_sha}..origin/main" 2>/dev/null || echo '?')"
    if [ "$sr_ref" = "refs/heads/main" ]; then
      echo "[pre-push] ✋ BLOCKED: pushing to main on a STALE base — origin/main is $behind commit(s) ahead and not in your history."
      echo "           Integrate first:  git fetch origin && git rebase origin/main"
      echo "           (Override only if you are certain it is safe: git push --no-verify)"
      block_stale=1
    else
      echo "[pre-push] ⚠️  WARNING: '$sr_ref' is BEHIND origin/main by $behind commit(s) — rebase before opening/merging the PR:"
      echo "           git fetch origin && git rebase origin/main"
    fi
  done <<EOF
$refs_input
EOF
fi
[ "$block_stale" = "1" ] && exit 1
# ----- end stale-base gate ---------------------------------------------------

changed=""
ranges=""
pushing_main=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$z40" ] && continue                 # branch delete — nothing to test
  [ "$remote_ref" = "refs/heads/main" ] && pushing_main=1
  if [ "$remote_sha" = "$z40" ]; then
    # New branch on remote: diff from the common ancestor with origin/main so we
    # classify ALL commits on the feature branch — not against the working tree
    # (a bare single sha compares to the working tree, which is always empty on a
    # clean checkout and gives wrong results on a dirty one; BUG-018).
    base="$(git merge-base origin/main "$local_sha" 2>/dev/null)" || base=""
    if [ -z "$base" ]; then
      # No merge-base (unrelated/shallow history): take the OLDEST commit not on any
      # origin ref and diff from its PARENT — `F..tip` excludes F's own changes, and a
      # single-commit branch would make the range empty and silently skip the gate.
      # A root-commit parent makes git diff fail → the BUG-068 guard forces force-full.
      first_new="$(git rev-list "$local_sha" --not --remotes=origin 2>/dev/null | tail -1)" || first_new=""
      if [ -n "$first_new" ]; then base="${first_new}^"; fi
    fi
    if [ -z "$base" ]; then
      # Cannot determine a safe base — run every spec rather than skip.
      echo "[pre-push] WARNING: could not find merge-base for new branch '$local_ref' — running the FULL spec set."
      changed="${changed}force-full
"
      continue
    fi
    range="$base..$local_sha"
  else
    range="$remote_sha..$local_sha"                     # only the commits being pushed
  fi
  # BUG-068: guard against git diff exit-non-zero (object missing locally after
  # a force-push from another machine); fall back to running every spec so the
  # hook never silently succeeds due to set -e swallowing 2>/dev/null errors.
  diff_out="$(git diff --name-only --diff-filter=ACMRD "$range" 2>/dev/null)" || {
    echo "[pre-push] WARNING: git diff failed for range '$range' (remote tip may not be local) — running the FULL spec set."
    changed="${changed}force-full
"
    continue
  }
  ranges="$ranges $range"
  changed="$changed$diff_out
"
done <<EOF
$refs_input
EOF

# Drop blank lines (the per-ref accumulation above leaves a trailing newline; a
# blank line matches no rule, so it would defeat the skip paths) and dedupe across refs.
changed="$(printf '%s\n' "$changed" | grep -v '^[[:space:]]*$' | sort -u)"

# Nothing to push (e.g. up-to-date / delete-only) → no e2e.
if [ -z "$changed" ]; then
  echo "[pre-push] no new commits to test — skipping e2e."
  exit 0
fi

remind() {
  echo "[pre-push] REMINDER: run the manual checks in docs/testing/MANUAL-CHECKS.md for the areas you touched -- it catches what e2e/unit do not."
}

if ! command -v pnpm >/dev/null 2>&1; then
  echo "[pre-push] ERROR: pnpm is not on PATH. Run 'corepack enable' first."
  exit 1
fi

# E2E_PRECOMMIT=1 turns on Playwright retries:2 (see playwright.config.ts) so the
# documented browser-trio env flake doesn't false-block a push.

# ----- full matrix: opt-in, or a direct push to main -------------------------
# The full cross-OS matrix is the MERGE gate, not the push gate. It runs here only
# when explicitly forced, or when the push target IS main (a direct-to-main push is
# effectively a merge).
#
# This block is deliberately FIRST — ahead of the version-only filter and every
# skip path below. Otherwise a direct-to-main push whose diff reduces to nothing
# but the `"version"` line (a lone version-bump commit, or a merge whose only
# residual diff is the bump) would hit the "version bump only — skipping e2e"
# early exit and never reach here, silently voiding the "a push to main always
# pays the full matrix" guarantee. Row 1 of the decision table in
# docs/testing/TESTING.md outranks every other row, and this ordering is what
# makes that true rather than merely documented.
if [ "${E2E_FULL_MATRIX:-}" = "1" ] || [ "$pushing_main" = "1" ]; then
  remind
  if [ "$pushing_main" = "1" ] && [ "${E2E_FULL_MATRIX:-}" != "1" ]; then
    echo "[pre-push] pushing to main — FULL e2e matrix (Windows native + Linux Docker, every spec)."
  else
    echo "[pre-push] E2E_FULL_MATRIX=1 — FULL e2e matrix (Windows native + Linux Docker, every spec)."
  fi
  # The Linux leg runs in Docker — fail early with a clear message if it is not up.
  if ! docker info >/dev/null 2>&1; then
    echo "[pre-push] ERROR: Docker daemon not running — the Linux e2e leg needs it."
    echo "           Start Docker Desktop, or bypass this push with: git push --no-verify"
    exit 1
  fi
  E2E_PRECOMMIT=1 pnpm test:e2e:matrix
  exit 0
fi

# ----- version-only package.json filter (2026-07-28) -------------------------
# CLAUDE.md requires a `version` bump in package.json in EVERY PR. package.json is
# genuinely cross-cutting (a deps/scripts edit changes what the app under test IS),
# so leaving it in the change-set forced FULL on literally every push and made all
# the scoping below dead code. A diff whose ONLY changed lines are the `"version"`
# field cannot change app behaviour — strip it. Any other package.json edit stays
# in the set and still routes to FULL. Only reachable on a NON-full-matrix push
# (see the block above), so it can never talk a push to main out of the matrix.
if printf '%s\n' "$changed" | grep -qx 'package.json'; then
  pj_nonversion=0
  for r in $ranges; do
    pj_body="$(git diff --unified=0 "$r" -- package.json 2>/dev/null || true)"
    # Keep only added/removed content lines (drop the ---/+++ file headers), then
    # look for anything that is NOT the version field. Non-empty ⇒ a real edit.
    other="$(printf '%s\n' "$pj_body" \
      | grep -E '^[+-]' \
      | grep -vE '^(\+\+\+|---)' \
      | grep -vE '^[+-][[:space:]]*"version"[[:space:]]*:' || true)"
    [ -n "$other" ] && pj_nonversion=1
  done
  if [ "$pj_nonversion" = "0" ]; then
    echo "[pre-push] package.json diff is the version bump only — not treating it as cross-cutting."
    changed="$(printf '%s\n' "$changed" | grep -vx 'package.json' || true)"
  fi
fi
if [ -z "$changed" ]; then
  echo "[pre-push] version bump only — skipping e2e."
  exit 0
fi
# ----- end version-only filter -----------------------------------------------

remind

# ----- e2e-spec-only push: run exactly the touched specs ---------------------
# Editing e2e specs used to route FULL (via the `e2e/` cross-cutting rule). When the
# ENTIRE change-set is spec files, the only thing that can have changed is those
# specs — run them by path. Any non-spec path alongside them falls through to the
# scope selector below, where `e2e/` still means FULL (a fixtures/helpers edit can
# perturb every spec).
non_spec="$(printf '%s\n' "$changed" | grep -vE '^e2e/[^/]+\.e2e\.ts$' || true)"
touched_specs="$(printf '%s\n' "$changed" | grep -E '^e2e/[^/]+\.e2e\.ts$' || true)"
if [ -z "$non_spec" ] && [ -n "$touched_specs" ]; then
  spec_count="$(printf '%s\n' "$touched_specs" | wc -l | tr -d ' ')"
  echo "[pre-push] e2e-spec-only push — Windows leg, $spec_count touched spec file(s) (full matrix at the merge gate)."
  # Deliberate word-split: each spec path is a positional FILE filter for Playwright.
  # shellcheck disable=SC2046,SC2086
  E2E_PRECOMMIT=1 pnpm test:e2e $(printf '%s ' $touched_specs)
  exit 0
fi

# ----- scoped Windows leg (the default path) ---------------------------------
# scripts/e2e-scope.mjs maps the changed paths to one of:
#   NONE  — nothing that can reach the running app (docs / vitest specs / CI / build
#           tooling) → skip e2e; the pre-commit trio + the Actions `check` job cover it,
#   FULL  — cross-cutting or unrecognised path → every spec, Windows leg,
#   @tags — a board-area subset (@core is always included).
# Fails OPEN to FULL on any error (node missing, parse failure).
SCOPE="$(printf '%s\n' "$changed" | node scripts/e2e-scope.mjs 2>/dev/null)" || SCOPE="FULL"
[ -z "$SCOPE" ] && SCOPE="FULL"

case "$SCOPE" in
  NONE)
    echo "[pre-push] no runtime surface touched (docs / unit tests / CI / build tooling) — skipping e2e."
    ;;
  FULL)
    echo "[pre-push] cross-cutting or unrecognised path — Windows e2e leg, ALL specs (Linux at the merge gate). Force both legs with E2E_FULL_MATRIX=1."
    E2E_PRECOMMIT=1 pnpm test:e2e
    ;;
  *)
    echo "[pre-push] Windows e2e leg, specs matching '$SCOPE' (Linux + full suite at the merge gate; force all with E2E_FULL_MATRIX=1)."
    # NB: NO `--` before the flags. pnpm 9 forwards the `--` separator itself into the
    # script, so `pnpm test:e2e -- --grep X` runs `playwright test -- --grep X` — and
    # Playwright treats everything after `--` as positional FILE-path filters, not a title
    # grep → "No tests found." `pnpm test:e2e --grep "$SCOPE"` forwards cleanly.
    E2E_PRECOMMIT=1 pnpm test:e2e --grep "$SCOPE"
    ;;
esac
